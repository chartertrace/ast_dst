{
  "name": "@chartertrace/dst-ast-view",
  "version": "0.1.0",
  "description": "Self-contained React component that visualises the static structure of the primary-server/sim deterministic simulation test (DST), from the AST model emitted by the astdst Go tool.",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "dev": "vite demo",
    "build:viewer": "vite build",
    "gen:tla": "tsx --tsconfig tsconfig.gen.json src/gen/cli-tla.ts",
    "gen:docs": "npm run build:viewer && tsx --tsconfig tsconfig.gen.json src/gen/cli-docs.tsx",
    "gen:reconcile": "tsx --tsconfig tsconfig.gen.json src/gen/cli-reconcile.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
